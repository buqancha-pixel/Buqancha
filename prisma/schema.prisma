generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SellerType {
  STORE       // do'kon
  PUBLISHER   // nashriyot
  MARKETPLACE // marketpleys
}

enum CollectorKind {
  NONE         // yig'ilmaydi (qo'lda)
  FEED         // hamkor feed'i (CSV/JSON)
  PRODUCT_PAGE // mahsulot sahifasidan (JSON-LD)
}

enum RunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum UnmatchedStatus {
  PENDING
  MATCHED
  IGNORED
}

enum OfferSource {
  PARTNER // hamkor
  AUTO    // avtomatik
  MANUAL  // qo'lda
}

model Author {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  nameCyrl    String?
  bio         String?
  birthYear   Int?
  deathYear   Int?
  // normallashtirilgan nom (qidiruv uchun)
  searchKey   String
  books       Book[]

  @@index([searchKey])
}

model Book {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  titleCyrl    String?
  description  String
  authorId     String
  author       Author    @relation(fields: [authorId], references: [id])
  // normallashtirilgan nom + muallif + kirill varianti (qidiruv uchun)
  searchKey    String
  searchCount  Int       @default(0)
  coverColor   String    @default("#1f6f5c")
  // "manual" — qo'lda kiritilgan, "import" — katalog importida avtomatik yaratilgan
  origin       String    @default("manual")
  // bosh sahifa banneri: admin tanlagan vaqt (bo'lmasa — avtomatik yangi kitoblar) va qisqa yozuv
  featuredAt   DateTime?
  featuredNote String?
  // katalog bo'limlari (lib/categories.ts dagi slug'lar; sotuvchi bo'limlaridan avtomatik yoki admin panelda)
  categories   String[]  @default([])
  promoters    PromoterBook[]
  editions     Edition[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([searchKey])
  @@index([searchCount])
  @@index([featuredAt])
  @@index([createdAt])
}

model Edition {
  id        String  @id @default(cuid())
  bookId    String
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  isbn      String? @unique
  publisher String
  year      Int?
  pages     Int?
  cover     String? // qattiq / yumshoq
  // nashr tili: bo'sh — o'zbekcha (lotin); "uz-Cyrl", "en", "ru", "tr" ... (boshqa tildagilar narx solishtirishga kirmaydi)
  language  String?
  // muqova rasmi: sotuvchi saytidagi havola yoki o'zimizning surat (/covers/...)
  imageUrl  String?
  // rasm manbasi: sotuvchi slug'i yoki "own" (o'z suratimiz)
  imageSource String?
  offers    Offer[]

  @@index([bookId])
}

model Seller {
  id       String     @id @default(cuid())
  slug     String     @unique
  name     String
  type     SellerType
  city     String
  website  String?
  // qidiruv havolasi shabloni, {q} o'rniga kitob nomi qo'yiladi
  searchUrlTemplate String?
  description String?
  address  String?
  // Instagram / Telegram (sayti bo'lmaganlar uchun)
  social   String?
  // xaritadagi joylashuv (admin panelda qo'lda kiritiladi; avtomatik geokodlash O'zbekistonda ishonchsiz)
  lat      Float?
  lng      Float?
  // ma'lumot olingan manbalar (tekshirish uchun)
  sources  String[]  @default([])
  // narx yig'ish sozlamalari
  collector    CollectorKind @default(NONE)
  feedUrl      String?
  // mahsulot sahifalarini topish uchun sitemap'lar (PRODUCT_PAGE)
  sitemapUrls  String[]      @default([])
  // sitemap'da mahsulotlar bo'lmasa: bo'lim sahifalari (?page=1, 2, ... yangi havola chiqmaguncha)
  listingUrls  String[]      @default([])
  // shu sotuvchidan qaysi tildagi kitoblar yangi kitob sifatida yaratilishi mumkin ("uz", "ru")
  importLanguages String[]   @default(["uz"])
  // katalog importi uchun: sitemap'dagi qaysi manzillar kitob sahifasi (regex)
  productUrlPattern String?
  crawlDelayMs Int           @default(3000)
  // sotuvchi rasmlarini ko'rsatishga rozilik (so'rov bo'lsa — false)
  allowImages  Boolean       @default(true)
  // hamkorlar kabineti: kirish havolasi kalitining SHA-256 xeshi (kalitning o'zi saqlanmaydi)
  partnerTokenHash String?   @unique
  partnerSince     DateTime?
  // kabinet va "Hamkor" belgisi shu sanagacha faol (bepul sinov yoki to'lov)
  partnerUntil     DateTime?
  offers   Offer[]
  runs     CollectorRun[]
  unmatched UnmatchedItem[]
}

model Offer {
  id          String      @id @default(cuid())
  editionId   String
  edition     Edition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  price       Int         // so'mda, butun son
  inStock     Boolean     @default(true)
  url         String?
  source      OfferSource @default(MANUAL)
  // namunaviy (haqiqiy emas) narx belgisi
  isSample    Boolean     @default(false)
  // oxirgi marta manbada ko'rilgan / tekshirilgan vaqt
  lastSeenAt  DateTime?
  checkedAt   DateTime?
  // shubhali narx: qo'llanmagan, ko'rib chiqish kerak
  pendingPrice Int?
  updatedAt   DateTime    @updatedAt
  history     PriceSnapshot[]

  @@unique([editionId, sellerId])
  @@index([sellerId])
}

model PartnerApplication {
  id          String     @id @default(cuid())
  orgName     String
  type        SellerType
  city        String
  website     String?
  contactName String
  phone       String
  email       String?
  message     String?
  createdAt   DateTime   @default(now())
}

model PriceSnapshot {
  id         String   @id @default(cuid())
  offerId    String
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  price      Int
  inStock    Boolean
  recordedAt DateTime @default(now())

  @@index([offerId, recordedAt])
}

model CollectorRun {
  id         String    @id @default(cuid())
  sellerId   String
  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  kind       CollectorKind
  status     RunStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  // { seen, updated, unchanged, created, unmatched, flagged, failed, markedOut }
  stats      Json?
  error      String?

  @@index([sellerId, startedAt])
}

model UnmatchedItem {
  id        String          @id @default(cuid())
  sellerId  String
  seller    Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  // sotuvchi tomonidagi kalit: havola yoki ISBN
  key       String
  title     String
  author    String?
  isbn      String?
  price     Int
  inStock   Boolean
  url       String?
  status    UnmatchedStatus @default(PENDING)
  firstSeen DateTime        @default(now())
  lastSeen  DateTime        @updatedAt

  @@unique([sellerId, key])
  @@index([status])
}

/// Kitob targ'ibotchilari (Instagram blogerlari) — admin qo'shadi; rozilik olinmaguncha saytda ko'rinmaydi
model Promoter {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  instagram String         // username, @ belgisisiz
  about     String?
  followers String?        // "120 ming" kabi matn
  photoUrl  String?
  consent   Boolean        @default(false)
  active    Boolean        @default(true)
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  books     PromoterBook[]
}

model PromoterBook {
  promoterId String
  promoter   Promoter @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@id([promoterId, bookId])
  @@index([bookId])
}
